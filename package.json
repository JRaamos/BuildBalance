{
  "name": "buildbalance",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev -w @buildbalance/api",
    "dev:web": "npm run dev -w @buildbalance/web",
    "build": "npm run build -w @buildbalance/api && npm run build -w @buildbalance/web",
    "lint": "npm run lint -w @buildbalance/api && npm run lint -w @buildbalance/web",
    "test": "npm run test -w @buildbalance/api",
    "db:generate": "npm run prisma:generate -w @buildbalance/api",
    "db:migrate": "npm run prisma:migrate -w @buildbalance/api",
    "db:deploy": "npm run prisma:deploy -w @buildbalance/api",
    "db:seed": "npm run prisma:seed -w @buildbalance/api",
    "db:studio": "npm run prisma:studio -w @buildbalance/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
